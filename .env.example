# --- Database ---
# PostgreSQL connection string (Railway provides this automatically when you
# attach a Postgres plugin to this service; copy its DATABASE_URL here / reference it).
DATABASE_URL="postgresql://user:password@localhost:5432/property_manager?schema=public"

# --- File storage ---
# "local" saves uploads to disk (./public/uploads) and is the zero-config default.
# "supabase" uploads to a Supabase Storage bucket instead (recommended for Railway,
# since Railway's filesystem is ephemeral on redeploys).
STORAGE_PROVIDER="local"

# Required only when STORAGE_PROVIDER="supabase"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="property-documents"

# --- App ---
# Base URL of the deployed app (used for absolute links, e.g. in emails later on)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node/Next runtime port (Railway sets PORT automatically; default for local dev)
PORT=3000
